{
    "name": "lostdomain/blog-kit",
    "description": "A complete blog for Laravel apps, fed by Marketing OS over a signed API.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Martijn Smit"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-feed": "^4.5",
        "spatie/laravel-responsecache": "^8.4",
        "spatie/laravel-sitemap": "^8.2",
        "spatie/schema-org": "^5.0",
        "symfony/html-sanitizer": "^8.1"
    },
    "require-dev": {
        "filament/filament": "^5.7",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^11.3",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "filament/filament": "Required (^5.7) for the BlogKitPlugin admin section."
    },
    "autoload": {
        "psr-4": {
            "Lostdomain\\BlogKit\\": "src/",
            "Lostdomain\\BlogKit\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lostdomain\\BlogKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lostdomain\\BlogKit\\BlogKitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
